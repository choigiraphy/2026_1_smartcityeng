# 공공데이터포털에서 발급받은 일반 인증키(Encoding)를 넣으세요.
PUBLIC_DATA_SERVICE_KEY=YOUR_ENCODED_SERVICE_KEY

# 선택: 서버 포트
PORT=5173

# 선택: 서울 열린데이터광장 실시간 도로 소통 정보 키
# TrafficInfo API로 주행시간을 교통상황 기반으로 보정합니다.
SEOUL_TRAFFIC_API_KEY=YOUR_SEOUL_OPEN_DATA_KEY

# 선택: 카카오모빌리티 REST API 키
# 카카오내비 Directions API로 실제 도로거리, 주행시간, 상세 경로선을 계산합니다.
KAKAO_MOBILITY_REST_API_KEY=YOUR_KAKAO_REST_API_KEY

# 선택: 카카오 지도 JavaScript 키
# Kakao Maps Web API로 대시보드의 지도 자체를 카카오 지도로 렌더링합니다.
# 카카오 개발자 사이트에서 JavaScript SDK 도메인에 http://localhost:5173 등록이 필요합니다.
KAKAO_MAPS_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# 선택: 실시간 대기/혼잡 스냅샷 자동 수집
# 서버가 켜져 있는 동안 지정 간격마다 API를 호출해 data/h2_station_snapshots.jsonl에 저장합니다.
H2_SNAPSHOT_COLLECTOR=1
H2_SNAPSHOT_INTERVAL_MINUTES=10
